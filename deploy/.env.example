# metor – server configuration (place as .env next to compose.yml, see INSTALL.md)

# Box image (default: the official server image from ghcr)
METOR_IMAGE=ghcr.io/metor-com/metor-box:latest

# Public base URL of the interface – ends up in the watch links that bots send
METOR_WATCH_BASE=https://bots.example.com

# Only with profile "caddy": domain for TLS (substituted in the Caddyfile, see Caddyfile.template)
METOR_DOMAIN=bots.example.com

# Optional: switch the gateway's own sign-in (devices, pairing) off – ONLY behind your own login
# layer or for local experiments; without any login the port must stay on 127.0.0.1
#METOR_AUTH=off

# Optional: push notification when a bot is waiting for an approval (ntfy.sh pattern)
#METOR_NTFY_URL=https://ntfy.sh/my-secret-topic

# Optional: auto-pause – a routine pauses after this many runs without a user message
# (default 20, 0 = off)
#METOR_ROUTINE_GUARD=20
