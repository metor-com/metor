{
  "name": "metor-push-relay",
  "version": "0.2.0",
  "description": "metor push relay (ADR-0017): forwards the gateway's Web Push messages, still encrypted, to APNs and FCM",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "relay.mjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node relay.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "npm install --no-save --no-fund --no-audit web-push@3.6.7 && node scripts/webpush-e2e.mjs"
  }
}
