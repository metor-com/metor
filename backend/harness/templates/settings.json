{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "ListAgents",
      "SendMessage",
      "Agent",
      "TodoWrite",
      "mcp__browser__*",
      "mcp__routines__*"
    ],
    "deny": [
      "Read(/workspace/bots/**/.claude/**)",
      "Read(/home/box/.claude/**)"
    ]
  },
  "crossSessionInbound": "accept",
  "isolatePeerMachines": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/metor/hooks/log-message.sh"
          }
        ]
      },
      {
        "matcher": "CronCreate",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/metor/hooks/block-cron.sh"
          }
        ]
      }
    ]
  }
}
