{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "TodoWrite",
      "mcp__browser__*",
      "mcp__routines__*",
      "mcp__metor__*"
    ],
    "deny": [
      "Read(/workspace/bots/**/.claude/**)",
      "Read(/home/box/.claude/**)",
      "ListAgents",
      "SendMessage"
    ]
  },
  "crossSessionInbound": "accept",
  "isolatePeerMachines": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "CronCreate",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/metor/hooks/block-cron.sh"
          }
        ]
      }
    ]
  }
}
