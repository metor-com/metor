{
  "name": "metor-mobile",
  "productName": "metor",
  "version": "0.2.0",
  "description": "metor – the app for iPhone and Android (ADR-0015): Capacitor around the unchanged interface",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ui": "cd ../../frontend && npm run build && node ../client/mobile/scripts/copy-ui.mjs",
    "sync": "npm run ui && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "run:ios": "npm run sync && cap run ios",
    "run:android": "npm run sync && cap run android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/inappbrowser": "^4.0.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "esbuild": "^0.27.0"
  }
}
